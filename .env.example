# ---------------------------------------------------------------------------
# FioForma — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure as mesmas chaves no
# provedor de hospedagem (produção). Nenhum segredo deve ir para o frontend.
# ---------------------------------------------------------------------------

# Banco de dados (MySQL/TiDB gerenciado). Em produção use o DSN do provedor.
DATABASE_URL="mysql://usuario:senha@host:4000/banco?sslaccept=strict"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"
# URL pública do site (usada em e-mails e callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cookies de sessão: em Preview/HTTPS cross-site use "true" (SameSite=None; Secure).
# Em desenvolvimento local via HTTP puro, use "false".
COOKIE_SECURE="true"

# Marca (fonte única: src/config/brand.ts lê estas variáveis)
NEXT_PUBLIC_BRAND_NAME="FioForma"
NEXT_PUBLIC_BRAND_TAGLINE="Moldes de costura em PDF, feitos para imprimir e costurar"

# Suporte — placeholders até a loja criar os canais
NEXT_PUBLIC_STORE_WHATSAPP="[WHATSAPP]"
NEXT_PUBLIC_STORE_EMAIL="[EMAIL]"
NEXT_PUBLIC_INSTAGRAM=""

# Pagamento: "mercadopago" (produção/sandbox real) ou "simulator" (somente demo local)
PAYMENT_GATEWAY="simulator"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Interface pronta para o futuro; não usada no MVP
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# E-mail transacional: "console" (loga no servidor) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="FioForma <nao-responda@fioforma.com.br>"

# Armazenamento privado: "db" (bytes no banco, padrão) ou "s3" (R2/S3)
STORAGE_DRIVER="db"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed do primeiro administrador (troque a senha após o primeiro acesso)
SEED_ADMIN_EMAIL="admin@fioforma.com.br"
SEED_ADMIN_PASSWORD="FioForma@2026"
SEED_DEMO_DATA="true"
